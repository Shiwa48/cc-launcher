<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Code Launcher"
        Width="620" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Yu Gothic UI" FontSize="14"
        UseLayoutRounding="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <Window.Resources>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- 見出し（クリップボード / お気に入り / 最近） -->
    <DataTemplate x:Key="GroupHeader">
      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="18,10,0,4"/>
    </DataTemplate>

    <!-- 1 行：アイコン / フォルダ名 / パス（控えめ） / 補足 -->
    <DataTemplate x:Key="RowTemplate">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28"/>
          <ColumnDefinition Width="Auto" MaxWidth="220"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock Grid.Column="2" Text="{Binding DisplayPath}" FontSize="12" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"
                   ToolTip="{Binding Path}"/>
        <TextBlock Grid.Column="3" Text="{Binding Meta}" FontSize="12" Margin="10,0,0,0"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>

    <Style x:Key="RowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="6,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="KeyHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
    </Style>
  </Window.Resources>

  <Border BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>  <!-- 検索 -->
        <RowDefinition Height="Auto"/>  <!-- 区切り -->
        <RowDefinition Height="Auto"/>  <!-- メッセージ -->
        <RowDefinition Height="Auto"/>  <!-- リスト / 空の状態 -->
        <RowDefinition Height="Auto"/>  <!-- 区切り -->
        <RowDefinition Height="Auto"/>  <!-- 操作 -->
        <RowDefinition Height="Auto"/>  <!-- キー操作のヒント -->
      </Grid.RowDefinitions>

      <!-- 検索欄：開いた瞬間に入力できる -->
      <Grid Grid.Row="0" Margin="16,12,10,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="18"
                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
        <Grid Grid.Column="1">
          <TextBlock x:Name="Placeholder" Text="フォルダを検索、またはパスを貼り付け" FontSize="18"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"
                     IsHitTestVisible="False" Margin="1,0,0,0"/>
          <TextBox x:Name="Search" FontSize="18" BorderThickness="0" Background="Transparent" Padding="0"
                   MinHeight="0" VerticalContentAlignment="Center" AutomationProperties.Name="フォルダを検索"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                   SelectionBrush="{DynamicResource AccentFillColorDefaultBrush}">
            <!-- 検索欄は枠や下線を付けず、パネル全体を検索フィールドとして見せる -->
            <TextBox.Template>
              <ControlTemplate TargetType="TextBox">
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
              </ControlTemplate>
            </TextBox.Template>
          </TextBox>
        </Grid>
        <Button x:Name="ClearButton" Grid.Column="2" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12"
                Padding="8" Margin="6,0,0,0" Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                ToolTip="クリア (Esc)" AutomationProperties.Name="検索をクリア" Focusable="False"/>
      </Grid>

      <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

      <!-- インラインのお知らせ（フォルダが無いなど） -->
      <Border x:Name="MessageBar" Grid.Row="2" Visibility="Collapsed" Margin="10,10,10,0" Padding="12,8" CornerRadius="4"
              Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
        <DockPanel>
          <Button x:Name="MessageAction" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,3" Focusable="False"/>
          <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <Grid Grid.Row="3">
        <ListBox x:Name="List" MaxHeight="420" Margin="0,4,0,6" BorderThickness="0" Background="Transparent"
                 ItemTemplate="{StaticResource RowTemplate}" ItemContainerStyle="{StaticResource RowStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False"
                 AutomationProperties.Name="フォルダの候補">
          <ListBox.GroupStyle>
            <GroupStyle HeaderTemplate="{StaticResource GroupHeader}"/>
          </ListBox.GroupStyle>
        </ListBox>
        <TextBlock x:Name="Empty" Visibility="Collapsed" Margin="20,22" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      </Grid>

      <Border Grid.Row="4" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

      <!-- 操作：主ボタンは右端の「新規で開く」 -->
      <Grid Grid.Row="5" Margin="10,10,12,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BrowseButton" Grid.Column="0" Padding="10,5" Background="Transparent" BorderThickness="0"
                ToolTip="フォルダを選ぶ (Ctrl+O)" Focusable="False">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="フォルダを選ぶ…" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="ContinueButton" Content="続きから" Padding="14,5" Margin="0,0,8,0" Focusable="False"
                  ToolTip="直前の会話を再開 (Ctrl+Enter)"/>
          <Button x:Name="ResumeButton" Content="選んで再開" Padding="14,5" Margin="0,0,8,0" Focusable="False"
                  ToolTip="過去のセッションを選んで再開 (Shift+Enter)"/>
          <Button x:Name="NewButton" Content="新規で開く" Padding="14,5" Focusable="False"
                  Style="{DynamicResource AccentButtonStyle}" ToolTip="新しいセッションを開始 (Enter)"/>
        </StackPanel>
      </Grid>
      <TextBlock x:Name="Hint" Grid.Row="6" Style="{StaticResource KeyHint}" Margin="16,0,16,10" TextTrimming="CharacterEllipsis"
                 Text="↑↓ 選択 · Enter 新規 · Ctrl+Enter 続き · Shift+Enter 選んで再開 · Ctrl+D お気に入り · Esc 閉じる"/>
    </Grid>
  </Border>
</Window>
